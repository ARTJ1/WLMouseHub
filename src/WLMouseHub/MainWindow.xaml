<Window x:Class="WLMouseHub.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WLMouse Hub" Icon="Assets/app.ico" Width="1260" Height="900" MinWidth="1180" MinHeight="820"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize"
        Background="{DynamicResource B.Shell}" Foreground="{DynamicResource B.Text}"
        FontFamily="{StaticResource F.Main}" FontSize="13" UseLayoutRounding="True">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" />
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="80" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ================= header ================= -->
        <Border Grid.Row="0" Background="{DynamicResource B.Header}" MouseLeftButtonDown="Header_MouseDown">
            <Grid Margin="28,0,16,0">
                <!-- logo -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
                    <Image x:Name="ImgLogo" Height="26" Visibility="Collapsed" />
                    <StackPanel x:Name="TxtLogo" Orientation="Horizontal">
                        <TextBlock Text="â©”" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource B.Logo}" VerticalAlignment="Center" />
                        <Rectangle Width="2" Height="22" Fill="{DynamicResource B.Logo}" Margin="6,0,8,0" />
                        <TextBlock Text="WLMOUSE" FontSize="22" FontWeight="Black" VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>

                <!-- page tabs -->
                <Border HorizontalAlignment="Center" VerticalAlignment="Center" Background="{DynamicResource B.Card}" CornerRadius="20" Padding="4">
                    <Grid x:Name="HeaderTabsHost">
                        <Border x:Name="HeaderCapsule" Background="{DynamicResource B.Pill}" CornerRadius="16" HorizontalAlignment="Left"
                                VerticalAlignment="Top" Width="0" />
                        <StackPanel x:Name="HeaderTabs" Orientation="Horizontal">
                            <RadioButton x:Name="TabMain" Style="{StaticResource SegRadio}" Content="{DynamicResource S.Main}" IsChecked="True"
                                         Checked="Tab_Checked" />
                            <RadioButton x:Name="TabSettings" Style="{StaticResource SegRadio}" Content="{DynamicResource S.Settings}"
                                         Checked="Tab_Checked" IsEnabled="False" />
                            <RadioButton x:Name="TabFirmware" Style="{StaticResource SegRadio}" Checked="Tab_Checked">
                                <Grid>
                                    <TextBlock Text="{DynamicResource S.Firmware}" />
                                    <Ellipse x:Name="FwDot" Width="7" Height="7" Fill="{DynamicResource B.Logo}" HorizontalAlignment="Right"
                                             VerticalAlignment="Top" Margin="0,-2,-10,0" Visibility="Collapsed" />
                                </Grid>
                            </RadioButton>
                            <RadioButton Style="{StaticResource SegRadio}" Content="{DynamicResource S.UserGuide}" Click="UserGuide_Click"
                                         GroupName="none" IsChecked="False" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- right side -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button x:Name="BtnLang" Style="{StaticResource IconButton}" Click="Lang_Click" ToolTip="{DynamicResource S.Language}">
                        <TextBlock x:Name="TxtLang" Text="EN" FontWeight="Bold" FontSize="13" />
                    </Button>
                    <Button Style="{StaticResource IconButton}" Margin="6,0,0,0" Click="Theme_Click" ToolTip="{DynamicResource S.Theme}">
                        <TextBlock x:Name="TxtThemeIcon" FontFamily="{StaticResource F.Icons}" Text="&#xE708;" FontSize="16" />
                    </Button>
                    <Button Style="{StaticResource IconButton}" Margin="6,0,0,0" Click="Home_Click" ToolTip="{DynamicResource S.Main}">
                        <TextBlock FontFamily="{StaticResource F.Icons}" Text="&#xE80F;" FontSize="16" />
                    </Button>
                    <Button Style="{StaticResource CaptionButton}" Margin="18,0,0,0" Click="Minimize_Click" ToolTip="{DynamicResource S.Minimize}">
                        <TextBlock FontFamily="{StaticResource F.Icons}" Text="&#xE921;" FontSize="10" />
                    </Button>
                    <Button Style="{StaticResource CaptionButton}" Click="Close_Click" ToolTip="{DynamicResource S.Close}">
                        <TextBlock FontFamily="{StaticResource F.Icons}" Text="&#xE8BB;" FontSize="10" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================= pages ================= -->
        <Grid Grid.Row="1">

            <!-- ======== HOME ======== -->
            <Grid x:Name="PageHome">
                <!-- connected device card -->
                <Border x:Name="CardDevice" Style="{StaticResource Card}" CornerRadius="30" Width="760" Height="380"
                        HorizontalAlignment="Center" VerticalAlignment="Center" Padding="36,30" Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="300" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid>
                            <Image x:Name="ImgHomeMouse" Height="250" Stretch="Uniform" Cursor="Hand" MouseLeftButtonUp="HomeMouse_Click"
                                   VerticalAlignment="Top" Margin="0,0,0,0" RenderTransformOrigin="0.5,0.5">
                                <Image.Effect>
                                    <DropShadowEffect Color="{DynamicResource C.Glow}" Opacity="{DynamicResource D.GlowOpacity}" BlurRadius="20" ShadowDepth="10" Direction="180" />
                                </Image.Effect>
                                <Image.RenderTransform><ScaleTransform x:Name="HomeMouseScale" /></Image.RenderTransform>
                                <Image.Triggers>
                                    <EventTrigger RoutedEvent="MouseEnter">
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="HomeMouseScale" Storyboard.TargetProperty="ScaleX" To="1.04" Duration="0:0:0.3" />
                                                <DoubleAnimation Storyboard.TargetName="HomeMouseScale" Storyboard.TargetProperty="ScaleY" To="1.04" Duration="0:0:0.3" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                    <EventTrigger RoutedEvent="MouseLeave">
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="HomeMouseScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.3" />
                                                <DoubleAnimation Storyboard.TargetName="HomeMouseScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.3" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Image.Triggers>
                            </Image>
                            <!-- the hub's pulsing "click me" dot on the mouse -->
                            <Ellipse x:Name="HomeHintDot" Width="22" Height="22" Fill="{DynamicResource B.Accent}" Opacity="0.75"
                                     HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,128,0,0" IsHitTestVisible="False" />
                            <TextBlock x:Name="TxtColorPage" Style="{StaticResource T.Muted}" FontSize="10" HorizontalAlignment="Center"
                                       VerticalAlignment="Bottom" Margin="0,0,0,-18" />
                            <!-- colour carousel: arrows + round thumbnails, like the hub -->
                            <StackPanel x:Name="ColorCarousel" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                                        ToolTip="{DynamicResource S.MouseColor}">
                                <Button x:Name="BtnColorPrev" Style="{StaticResource IconButton}" Width="34" Height="34" Click="ColorPrev_Click">
                                    <TextBlock FontFamily="{StaticResource F.Icons}" Text="&#xE72B;" FontSize="12" />
                                </Button>
                                <Border Width="162" Height="40" ClipToBounds="True" Margin="6,0" Padding="0,2">
                                    <StackPanel x:Name="PanelColors" Orientation="Horizontal" HorizontalAlignment="Left">
                                        <StackPanel.RenderTransform><TranslateTransform x:Name="ColorsShift" /></StackPanel.RenderTransform>
                                    </StackPanel>
                                </Border>
                                <Button x:Name="BtnColorNext" Style="{StaticResource IconButton}" Width="34" Height="34" Click="ColorNext_Click">
                                    <TextBlock FontFamily="{StaticResource F.Icons}" Text="&#xE72A;" FontSize="12" />
                                </Button>
                            </StackPanel>
                        </Grid>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="24,0,0,0">
                            <Border Background="{DynamicResource B.Shell}" CornerRadius="24" Padding="20,18">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,26">
                                        <TextBlock x:Name="TxtHomeConn" DockPanel.Dock="Right" FontFamily="{StaticResource F.Icons}" FontSize="16"
                                                   Foreground="{DynamicResource B.Accent}" VerticalAlignment="Center" />
                                        <TextBlock x:Name="TxtHomeModel" Style="{StaticResource T.Big}" />
                                    </DockPanel>
                                    <UniformGrid Columns="2">
                                        <Border Style="{StaticResource PillBox}" Margin="0,0,6,8"><TextBlock x:Name="TxtHomeDpi" Style="{StaticResource T.Small}" HorizontalAlignment="Center" /></Border>
                                        <Border Style="{StaticResource PillBox}" Margin="6,0,0,8"><TextBlock x:Name="TxtHomePoll" Style="{StaticResource T.Small}" HorizontalAlignment="Center" /></Border>
                                        <Border Style="{StaticResource PillBox}" Margin="0,0,6,8" Padding="4">
                                            <Grid SizeChanged="BatteryPill_SizeChanged">
                                                <Border x:Name="BarHomeBat" Background="{DynamicResource B.Accent}" CornerRadius="10" HorizontalAlignment="Left" Width="0" />
                                                <TextBlock x:Name="TxtHomeBat" Style="{StaticResource T.Small}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                        <Border Style="{StaticResource PillBox}" Margin="6,0,0,8"><TextBlock x:Name="TxtHomeLod" Style="{StaticResource T.Small}" HorizontalAlignment="Center" /></Border>
                                        <Border Style="{StaticResource PillBox}" Margin="0,0,6,0"><TextBlock x:Name="TxtHomeDongle" Style="{StaticResource T.Small}" HorizontalAlignment="Center" /></Border>
                                        <Border Style="{StaticResource PillBox}" Margin="6,0,0,0"><TextBlock x:Name="TxtHomeFw" Style="{StaticResource T.Small}" HorizontalAlignment="Center" /></Border>
                                    </UniformGrid>
                                </StackPanel>
                            </Border>
                            <UniformGrid Columns="2" Margin="0,10,0,0">
                                <Button Content="{DynamicResource S.OpenSettings}" Margin="0,0,6,0" Click="HomeMouse_Click" />
                                <Button Content="{DynamicResource S.Firmware}" Margin="6,0,0,0" Click="GoFirmware_Click" />
                            </UniformGrid>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- nothing connected -->
                <Border x:Name="CardNoDevice" Style="{StaticResource Card}" CornerRadius="30" Width="620" Height="300"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Border Width="52" Height="52" CornerRadius="26" BorderThickness="3" BorderBrush="{DynamicResource B.Text}" Margin="0,0,0,18">
                            <TextBlock Text="+" FontSize="36" FontWeight="Light" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-6,0,0" />
                        </Border>
                        <TextBlock Text="{DynamicResource S.NoDevice}" FontWeight="SemiBold" HorizontalAlignment="Center" />
                        <TextBlock Text="{DynamicResource S.Supported}" Style="{StaticResource T.Muted}" HorizontalAlignment="Center" Margin="0,14,0,4" />
                        <TextBlock x:Name="TxtSupported" Style="{StaticResource T.Muted}" TextAlignment="Center" MaxWidth="460" />
                        <TextBlock Text="{DynamicResource S.Searching}" Style="{StaticResource T.Muted}" HorizontalAlignment="Center" Margin="0,16,0,0" />
                    </StackPanel>
                </Border>

                <!-- app options -->
                <StackPanel HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="32,0,0,24">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <CheckBox x:Name="ChkStartup" Style="{StaticResource Switch}" Checked="Startup_Changed" Unchecked="Startup_Changed" />
                        <TextBlock Text="{DynamicResource S.StartWithWindows}" Style="{StaticResource T.Small}" Margin="10,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <CheckBox x:Name="ChkCloseToTray" Style="{StaticResource Switch}" Checked="Tray_Changed" Unchecked="Tray_Changed" />
                        <TextBlock Text="{DynamicResource S.KeepInTray}" Style="{StaticResource T.Small}" Margin="10,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- ======== SETTINGS ======== -->
            <Grid x:Name="PageSettings" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="200" />
                </Grid.RowDefinitions>

                <!-- top: buttons around the mouse -->
                <Grid Grid.Row="0" Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="200" />
                        <ColumnDefinition Width="380" />
                        <ColumnDefinition Width="200" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel x:Name="PanelButtonsLeft" Grid.Column="1" VerticalAlignment="Top" Margin="0,50,0,0" />

                    <!-- Same geometry as the hub: a 214 px box centred on the mouse, the 1018x626 picture drawn 410 px tall
                         and overflowing it, markers placed at KeyPosition (top, left) inside the box. -->
                    <Grid Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Top" Width="214" Height="470" ClipToBounds="False">
                        <Image x:Name="ImgKeyMouse" Height="410" VerticalAlignment="Top" HorizontalAlignment="Left"
                               Margin="0,40,0,0" Stretch="Uniform" IsHitTestVisible="False">
                            <Image.Effect>
                                <DropShadowEffect Color="{DynamicResource C.Glow}" Opacity="{DynamicResource D.GlowOpacity}" BlurRadius="20" ShadowDepth="10" Direction="180" />
                            </Image.Effect>
                        </Image>
                        <Canvas x:Name="CanvasMarkers" />
                    </Grid>

                    <StackPanel x:Name="PanelButtonsRight" Grid.Column="3" VerticalAlignment="Top" Margin="0,50,0,0" />

                    <!-- info card -->
                    <!-- like the hub: pinned to the right edge, never under the centred profile tabs -->
                    <Border Grid.Column="0" Grid.ColumnSpan="5" Style="{StaticResource Card}" Width="268" HorizontalAlignment="Right"
                            VerticalAlignment="Bottom" Margin="0,0,30,14" Padding="18,14">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <TextBlock x:Name="TxtInfoModel" Style="{StaticResource T.Big}" />
                                <ContentControl Style="{StaticResource Help}" x:Name="HelpModel" />
                            </StackPanel>
                            <UniformGrid Columns="2">
                                <Border Style="{StaticResource PillBox}" Margin="0,0,5,8"><TextBlock x:Name="TxtInfoDpi" Style="{StaticResource T.Small}" HorizontalAlignment="Center" /></Border>
                                <Border Style="{StaticResource PillBox}" Margin="5,0,0,8"><TextBlock x:Name="TxtInfoPoll" Style="{StaticResource T.Small}" HorizontalAlignment="Center" /></Border>
                                <Border Style="{StaticResource PillBox}" Margin="0,0,5,8" Padding="4">
                                    <Grid SizeChanged="BatteryPill_SizeChanged">
                                        <Border x:Name="BarInfoBat" Background="{DynamicResource B.Accent}" CornerRadius="10" HorizontalAlignment="Left" Width="0" />
                                        <TextBlock x:Name="TxtInfoBat" Style="{StaticResource T.Small}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                                <Border Style="{StaticResource PillBox}" Margin="5,0,0,8"><TextBlock x:Name="TxtInfoLod" Style="{StaticResource T.Small}" HorizontalAlignment="Center" /></Border>
                                <Button Content="{DynamicResource S.ResetProfile}" Margin="0,0,5,0" Padding="4,0" Height="30" VerticalAlignment="Top" FontSize="11.5" Click="ResetProfile_Click" />
                                <Button Content="{DynamicResource S.FactoryReset}" Margin="5,0,0,0" Padding="4,0" Height="30" VerticalAlignment="Top" FontSize="11.5" Click="FactoryReset_Click" />
                            </UniformGrid>
                        </StackPanel>
                    </Border>

                    <!-- profile tabs -->
                    <Border Grid.Column="1" Grid.ColumnSpan="3" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                            Background="{DynamicResource B.Header}" CornerRadius="22,22,0,0" Padding="8,8,8,4">
                        <Grid x:Name="ProfileHost">
                            <Border x:Name="ProfileCapsule" Background="{DynamicResource B.Card}" CornerRadius="16" HorizontalAlignment="Left"
                                    VerticalAlignment="Top" Width="0" />
                            <StackPanel x:Name="PanelProfiles" Orientation="Horizontal" />
                        </Grid>
                    </Border>
                </Grid>

                <!-- bottom panel -->
                <Border Grid.Row="1" Background="{DynamicResource B.Header}" CornerRadius="0" Padding="12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="168" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource Card}" Padding="10,12" Margin="0,0,10,0">
                            <StackPanel VerticalAlignment="Center">
                                <RadioButton x:Name="NavPerf" Style="{StaticResource NavRadio}" Content="{DynamicResource S.Performance}" IsChecked="True" Checked="Nav_Checked" />
                                <RadioButton x:Name="NavDpi" Style="{StaticResource NavRadio}" Content="{DynamicResource S.DPI}" Checked="Nav_Checked" />
                                <RadioButton x:Name="NavMacro" Style="{StaticResource NavRadio}" Content="{DynamicResource S.Macro}" Checked="Nav_Checked" />
                                <RadioButton x:Name="NavLight" Style="{StaticResource NavRadio}" Checked="Nav_Checked" Click="NavLight_Click" Margin="0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock x:Name="TxtNavLight" Text="{DynamicResource S.Lighting}" />
                                        <TextBlock x:Name="NavLightChevron" FontFamily="{StaticResource F.Icons}" Text="&#xE70D;" FontSize="10"
                                                   Margin="8,2,0,0" Visibility="Collapsed" />
                                    </StackPanel>
                                </RadioButton>
                            </StackPanel>
                        </Border>

                        <!-- ===== Performance ===== -->
                        <Grid x:Name="PanelPerf" Grid.Column="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="190" />
                                <ColumnDefinition Width="200" />
                                <ColumnDefinition Width="200" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Border Style="{StaticResource Card}" Margin="0,0,8,8">
                                <StackPanel VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <TextBlock Text="{DynamicResource S.PollingRate}" Style="{StaticResource T.Title}" />
                                        <ContentControl Style="{StaticResource Help}" ToolTip="{DynamicResource S.Tip.Polling}" />
                                    </StackPanel>
                                    <ComboBox x:Name="CmbPolling" SelectionChanged="Polling_Changed" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,8,0">
                                <StackPanel VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <TextBlock Text="{DynamicResource S.LOD}" Style="{StaticResource T.Title}" />
                                        <ContentControl Style="{StaticResource Help}" ToolTip="{DynamicResource S.Tip.LOD}" />
                                    </StackPanel>
                                    <ComboBox x:Name="CmbLod" SelectionChanged="Lod_Changed" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="1" Style="{StaticResource Card}" Margin="0,0,8,8">
                                <StackPanel VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <TextBlock Text="{DynamicResource S.Debounce}" Style="{StaticResource T.Title}" />
                                        <ContentControl Style="{StaticResource Help}" ToolTip="{DynamicResource S.Tip.Debounce}" />
                                    </StackPanel>
                                    <Slider x:Name="SldDebounce" Minimum="0" Maximum="15" TickFrequency="1" IsSnapToTickEnabled="True" Tag="ms"
                                            PreviewMouseUp="Debounce_Commit" KeyUp="Debounce_Commit" />
                                    <DockPanel Margin="4,0">
                                        <TextBlock Text="0" Style="{StaticResource T.Small}" FontSize="9" />
                                        <TextBlock Text="15" Style="{StaticResource T.Small}" FontSize="9" HorizontalAlignment="Right" />
                                    </DockPanel>
                                </StackPanel>
                            </Border>
                            <Border x:Name="CardAngleTune" Grid.Column="2" Style="{StaticResource Card}" Margin="0,0,8,8">
                                <StackPanel VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <TextBlock Text="{DynamicResource S.AngleTune}" Style="{StaticResource T.Title}" />
                                        <ContentControl Style="{StaticResource Help}" ToolTip="{DynamicResource S.Tip.AngleTune}" />
                                    </StackPanel>
                                    <Slider x:Name="SldAngleTune" Minimum="-30" Maximum="30" TickFrequency="1" IsSnapToTickEnabled="True" Tag="Â°"
                                            PreviewMouseUp="AngleTune_Commit" KeyUp="AngleTune_Commit" />
                                    <DockPanel Margin="4,0">
                                        <TextBlock Text="-30Â°" Style="{StaticResource T.Small}" FontSize="9" />
                                        <TextBlock Text="30Â°" Style="{StaticResource T.Small}" FontSize="9" HorizontalAlignment="Right" />
                                    </DockPanel>
                                </StackPanel>
                            </Border>
                            <Border x:Name="CardSleep" Grid.Column="1" Grid.ColumnSpan="2" Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,8,0">
                                <StackPanel VerticalAlignment="Center">
                                    <DockPanel Margin="0,0,0,6">
                                        <CheckBox x:Name="ChkSleep" DockPanel.Dock="Right" Style="{StaticResource Switch}" Checked="SleepToggle_Changed" Unchecked="SleepToggle_Changed" />
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{DynamicResource S.SleepTime}" Style="{StaticResource T.Title}" />
                                            <ContentControl Style="{StaticResource Help}" ToolTip="{DynamicResource S.Tip.Sleep}" />
                                        </StackPanel>
                                    </DockPanel>
                                    <Slider x:Name="SldSleep" Minimum="1" Maximum="30" TickFrequency="1" IsSnapToTickEnabled="True" Tag="min"
                                            PreviewMouseUp="Sleep_Commit" KeyUp="Sleep_Commit" />
                                    <DockPanel Margin="4,0">
                                        <TextBlock Text="1" Style="{StaticResource T.Small}" FontSize="9" />
                                        <TextBlock Text="30" Style="{StaticResource T.Small}" FontSize="9" HorizontalAlignment="Right" />
                                    </DockPanel>
                                </StackPanel>
                            </Border>

                            <!-- toggles -->
                            <UniformGrid x:Name="PanelToggles" Grid.Column="3" Grid.ColumnSpan="2" Grid.RowSpan="2" Columns="2" Rows="3" />
                        </Grid>

                        <!-- ===== DPI ===== -->
                        <Grid x:Name="PanelDpi" Grid.Column="1" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="230" />
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource Card}" Padding="14,8" Margin="0,0,10,0">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsControl x:Name="LstStages">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Height="25">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="30" />
                                                        <ColumnDefinition Width="76" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="30" />
                                                    </Grid.ColumnDefinitions>
                                                    <RadioButton Style="{StaticResource DotRadio}" GroupName="DpiStage" IsChecked="{Binding IsActive, Mode=OneWay}"
                                                                 Checked="Stage_Activated" VerticalAlignment="Center" />
                                                    <TextBox Grid.Column="1" Text="{Binding X, UpdateSourceTrigger=PropertyChanged}" MinHeight="20" Height="20" Padding="4,0"
                                                             FontSize="11.5" KeyDown="DpiBox_KeyDown" LostFocus="DpiBox_LostFocus" />
                                                    <Slider Grid.Column="2" Style="{StaticResource DotSlider}" Value="{Binding XValue, Mode=TwoWay}" Minimum="50"
                                                            Maximum="{Binding Max}" SmallChange="{Binding Step}" LargeChange="{Binding Step}" Margin="12,0"
                                                            VerticalAlignment="Center" PreviewMouseUp="DpiSlider_Commit" />
                                                    <TextBox Grid.Column="3" Text="{Binding Y, UpdateSourceTrigger=PropertyChanged}" MinHeight="20" Height="20" Padding="4,0" FontSize="11.5"
                                                             Width="76" Visibility="{Binding YVisibility}" KeyDown="DpiBox_KeyDown" LostFocus="DpiBox_LostFocus" />
                                                    <Slider Grid.Column="4" Style="{StaticResource DotSlider}" Value="{Binding YValue, Mode=TwoWay}" Minimum="50"
                                                            Maximum="{Binding Max}" Width="180" Margin="12,0,0,0" VerticalAlignment="Center"
                                                            Visibility="{Binding YVisibility}" PreviewMouseUp="DpiSlider_Commit" />
                                                    <Ellipse Grid.Column="5" Width="12" Height="12" Fill="{Binding Brush}" HorizontalAlignment="Right"
                                                             Cursor="Hand" MouseLeftButtonUp="StageColor_Click" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <DockPanel Margin="0,0,0,18">
                                    <CheckBox x:Name="ChkSeparateXY" DockPanel.Dock="Right" Style="{StaticResource Switch}" Checked="SeparateXY_Changed" Unchecked="SeparateXY_Changed" />
                                    <TextBlock Text="{DynamicResource S.EnableXY}" Style="{StaticResource T.Title}" />
                                </DockPanel>
                                <DockPanel Margin="0,0,0,18">
                                    <Border x:Name="SwatchActive" DockPanel.Dock="Right" Width="28" Height="28" CornerRadius="4" BorderThickness="2"
                                            BorderBrush="{DynamicResource B.Outline}" Cursor="Hand" MouseLeftButtonUp="ActiveColor_Click" />
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{DynamicResource S.SelectColor}" Style="{StaticResource T.Title}" />
                                        <ContentControl Style="{StaticResource Help}" ToolTip="{DynamicResource S.Tip.SelectColor}" />
                                    </StackPanel>
                                </DockPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="{DynamicResource S.DpiStage}" Style="{StaticResource T.Title}" />
                                    <ContentControl Style="{StaticResource Help}" ToolTip="{DynamicResource S.Tip.DpiStage}" />
                                </StackPanel>
                                <ComboBox x:Name="CmbStageCount" SelectionChanged="StageCount_Changed" />
                                <TextBlock x:Name="TxtDpiRange" Style="{StaticResource T.Muted}" Margin="0,8,0,0" FontSize="10.5" />
                            </StackPanel>
                        </Grid>

                        <!-- ===== Macro ===== -->
                        <Grid x:Name="PanelMacro" Grid.Column="1" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="360" />
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource Card}" Padding="8" Margin="0,0,10,0">
                                <StackPanel x:Name="PanelMacroSlots" VerticalAlignment="Center" />
                            </Border>
                            <Border Grid.Column="1" Style="{StaticResource Card}" Padding="10" Margin="0,0,10,0">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <UniformGrid Columns="4" Margin="0,0,0,8">
                                        <ToggleButton x:Name="BtnRecord" Content="{DynamicResource S.Record}" Margin="0,0,6,0" Checked="Record_Checked" Unchecked="Record_Unchecked" />
                                        <Button x:Name="BtnInsert" Margin="0,0,6,0" Click="Insert_Click">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{DynamicResource S.Insert}" />
                                                <TextBlock FontFamily="{StaticResource F.Icons}" Text="&#xE70D;" FontSize="10" Margin="8,2,0,0" />
                                            </StackPanel>
                                        </Button>
                                        <Button Content="{DynamicResource S.SaveMacro}" Margin="0,0,6,0" Click="SaveMacro_Click" />
                                        <Button Content="{DynamicResource S.DeleteMacro}" Click="DeleteMacro_Click" />
                                    </UniformGrid>
                                    <Border Grid.Row="1" Background="{DynamicResource B.Shell}" CornerRadius="14" BorderBrush="{DynamicResource B.Pill}" BorderThickness="1">
                                        <Grid>
                                            <ListBox x:Name="LstMacroEvents" SelectionMode="Extended" Margin="6" KeyDown="MacroEvents_KeyDown">
                                                <ListBox.ContextMenu>
                                                    <ContextMenu>
                                                        <MenuItem Header="{DynamicResource S.MoveUp}" Click="MoveEventUp_Click" />
                                                        <MenuItem Header="{DynamicResource S.MoveDown}" Click="MoveEventDown_Click" />
                                                        <MenuItem Header="{DynamicResource S.Remove}" Click="RemoveEvent_Click" />
                                                    </ContextMenu>
                                                </ListBox.ContextMenu>
                                                <ListBox.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel />
                                                    </ItemsPanelTemplate>
                                                </ListBox.ItemsPanel>
                                            </ListBox>
                                            <TextBlock x:Name="TxtMacroHint" Text="{DynamicResource S.MacroHint}" Style="{StaticResource T.Muted}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" />
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Border>
                            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="10,12">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{DynamicResource S.RecordDelaySettings}" Style="{StaticResource T.Title}" FontWeight="Black" Margin="0,0,0,20" />
                                    <DockPanel Margin="6,0,0,16">
                                        <TextBox x:Name="TxtDelayMs" DockPanel.Dock="Right" Width="150" Text="50" Background="{DynamicResource B.PillHover}" />
                                        <TextBlock Text="{DynamicResource S.KeyDelay}" Style="{StaticResource T.Title}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    </DockPanel>
                                    <UniformGrid Columns="3">
                                        <RadioButton x:Name="RbRecordDelay" Style="{StaticResource NavRadio}" Content="{DynamicResource S.RecordDelay}" IsChecked="True" Margin="0,0,4,0" Padding="4,4" FontSize="11.5" GroupName="delay" />
                                        <RadioButton x:Name="RbDefaultDelay" Style="{StaticResource NavRadio}" Content="{DynamicResource S.DefaultDelay}" Margin="2,0" Padding="4,4" FontSize="11.5" GroupName="delay" />
                                        <RadioButton x:Name="RbNoDelay" Style="{StaticResource NavRadio}" Content="{DynamicResource S.NoDelay}" Margin="4,0,0,0" Padding="4,4" FontSize="11.5" GroupName="delay" />
                                    </UniformGrid>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- ===== Dongle Screen (HUAN receiver display) ===== -->
                        <Grid x:Name="PanelScreen" Grid.Column="1" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="190" />
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="220" />
                            </Grid.ColumnDefinitions>
                            <!-- library -->
                            <Border Style="{StaticResource Card}" Padding="10,8" Margin="0,0,8,0">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                                        <TextBlock Text="{DynamicResource S.ScreenLibrary}" Style="{StaticResource T.Small}" />
                                        <ContentControl Style="{StaticResource Help}" ToolTip="{DynamicResource S.Tip.ScreenLibrary}" />
                                    </StackPanel>
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
                                        <UniformGrid x:Name="PanelScreenLibrary" Columns="5" VerticalAlignment="Top" />
                                    </ScrollViewer>
                                </DockPanel>
                            </Border>
                            <!-- customize -->
                            <Border Grid.Column="1" Style="{StaticResource Card}" Padding="10,8" Margin="0,0,8,0">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                                        <TextBlock Text="{DynamicResource S.Customize}" Style="{StaticResource T.Small}" />
                                        <ContentControl Style="{StaticResource Help}" ToolTip="{DynamicResource S.Tip.Customize}" />
                                    </StackPanel>
                                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                                        <Button Style="{StaticResource IconButton}" Width="26" Height="26" Background="White" Click="ScreenAdd_Click"
                                                ToolTip="{DynamicResource S.Tip.Customize}">
                                            <TextBlock Text="+" Foreground="Black" FontSize="16" Margin="0,-3,0,0" />
                                        </Button>
                                        <Button Style="{StaticResource IconButton}" Width="26" Height="26" Margin="6,0,0,0" Background="{DynamicResource B.Accent}"
                                                Click="ScreenRemoveCustom_Click" ToolTip="{DynamicResource S.Remove}">
                                            <TextBlock FontFamily="{StaticResource F.Icons}" Text="&#xE74D;" FontSize="11" Foreground="White" />
                                        </Button>
                                    </StackPanel>
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
                                        <UniformGrid x:Name="PanelScreenCustom" Columns="4" VerticalAlignment="Top" />
                                    </ScrollViewer>
                                </DockPanel>
                            </Border>
                            <!-- slots -->
                            <Grid Grid.Column="2" Margin="0,0,8,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Border Style="{StaticResource Card}" Padding="10,6" Margin="0,0,0,6">
                                    <DockPanel>
                                        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Top" Width="62">
                                            <TextBlock Text="{DynamicResource S.ScreenMain}" Style="{StaticResource T.Small}" />
                                            <ContentControl Style="{StaticResource Help}" ToolTip="{DynamicResource S.Tip.ScreenMain}" />
                                        </StackPanel>
                                        <Border Background="{DynamicResource B.Shell}" CornerRadius="26" Padding="12,0">
                                            <StackPanel x:Name="PanelScreenMain" Orientation="Horizontal" VerticalAlignment="Center" />
                                        </Border>
                                    </DockPanel>
                                </Border>
                                <Border Grid.Row="1" Style="{StaticResource Card}" Padding="10,6">
                                    <DockPanel>
                                        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Top" Width="62">
                                            <TextBlock Text="{DynamicResource S.ScreenRandom}" Style="{StaticResource T.Small}" />
                                            <ContentControl Style="{StaticResource Help}" ToolTip="{DynamicResource S.Tip.ScreenRandom}" />
                                        </StackPanel>
                                        <Border Background="{DynamicResource B.Shell}" CornerRadius="26" Padding="12,0">
                                            <StackPanel x:Name="PanelScreenRandom" Orientation="Horizontal" VerticalAlignment="Center" />
                                        </Border>
                                    </DockPanel>
                                </Border>
                            </Grid>
                            <!-- switches and actions -->
                            <StackPanel Grid.Column="3" VerticalAlignment="Center" Margin="4,0,0,0">
                                <DockPanel Margin="0,0,0,12">
                                    <CheckBox x:Name="ChkScreenStatus" DockPanel.Dock="Right" Style="{StaticResource Switch}" Tag="Status" Checked="ScreenFlag_Changed" Unchecked="ScreenFlag_Changed" />
                                    <TextBlock Text="{DynamicResource S.ScreenStatus}" Style="{StaticResource T.Title}" FontWeight="Black" />
                                </DockPanel>
                                <DockPanel Margin="0,0,0,12">
                                    <CheckBox x:Name="ChkScreenEffect" DockPanel.Dock="Right" Style="{StaticResource Switch}" Tag="Effect" Checked="ScreenFlag_Changed" Unchecked="ScreenFlag_Changed" />
                                    <TextBlock Text="{DynamicResource S.ScreenEffect}" Style="{StaticResource T.Title}" FontWeight="Black" />
                                </DockPanel>
                                <DockPanel Margin="0,0,0,14">
                                    <CheckBox x:Name="ChkScreenVoice" DockPanel.Dock="Right" Style="{StaticResource Switch}" Tag="Voice" Checked="ScreenFlag_Changed" Unchecked="ScreenFlag_Changed" />
                                    <TextBlock Text="{DynamicResource S.ScreenVoice}" Style="{StaticResource T.Title}" FontWeight="Black" />
                                </DockPanel>
                                <UniformGrid Columns="2">
                                    <Button Content="{DynamicResource S.Update}" FontWeight="Black" Margin="0,0,5,0" Click="ScreenUpdate_Click" />
                                    <Button Content="{DynamicResource S.Delete}" FontWeight="Black" Margin="5,0,0,0" Click="ScreenDelete_Click" />
                                </UniformGrid>
                                <TextBlock x:Name="TxtScreenSize" Style="{StaticResource T.Muted}" FontSize="10.5" HorizontalAlignment="Center" Margin="0,6,0,0" />
                            </StackPanel>
                        </Grid>

                        <!-- ===== Lighting ===== -->
                        <Grid x:Name="PanelLight" Grid.Column="1" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="260" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="TxtNoLighting" Grid.ColumnSpan="3" Text="{DynamicResource S.NoLighting}" Style="{StaticResource T.Muted}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
                            <Border x:Name="CardLightMain" Style="{StaticResource Card}" Margin="0,0,10,0">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{DynamicResource S.LightingEffect}" Style="{StaticResource T.Title}" Margin="0,0,0,10" />
                                    <DockPanel Margin="0,0,0,12">
                                        <TextBlock Text="{DynamicResource S.Effect}" Style="{StaticResource T.Small}" FontSize="12.5" VerticalAlignment="Center" Margin="0,0,14,0" />
                                        <ComboBox x:Name="CmbEffect" SelectionChanged="Effect_Changed" />
                                    </DockPanel>
                                    <Border Background="{DynamicResource B.Shell}" CornerRadius="14" Padding="12,6">
                                        <StackPanel>
                                            <DockPanel Margin="0,2">
                                                <TextBlock Text="{DynamicResource S.Bright}" Style="{StaticResource T.Small}" Width="56" VerticalAlignment="Center" />
                                                <Slider x:Name="SldBrightness" Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" Tag="%"
                                                        PreviewMouseUp="Brightness_Commit" KeyUp="Brightness_Commit" />
                                            </DockPanel>
                                            <DockPanel x:Name="RowSpeed" Margin="0,2">
                                                <TextBlock Text="{DynamicResource S.Speed}" Style="{StaticResource T.Small}" Width="56" VerticalAlignment="Center" />
                                                <Slider x:Name="SldSpeed" Minimum="1" Maximum="6" TickFrequency="1" IsSnapToTickEnabled="True" Tag=""
                                                        PreviewMouseUp="Speed_Commit" KeyUp="Speed_Commit" />
                                            </DockPanel>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>
                            <Border x:Name="CardLightPicker" Grid.Column="1" Style="{StaticResource Card}" Margin="0,0,10,0" Padding="12">
                                <ContentControl x:Name="HostLightPicker" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel x:Name="CardLightSwatches" Grid.Column="2" VerticalAlignment="Center">
                                <Border Style="{StaticResource Card}" Padding="12,8" Margin="0,0,0,8">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource S.Color}" Style="{StaticResource T.Small}" Margin="0,0,0,6" />
                                        <StackPanel x:Name="PanelPresetColors" Orientation="Horizontal" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Card}" Padding="12,8">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource S.Recent}" Style="{StaticResource T.Small}" Margin="0,0,0,6" />
                                        <StackPanel x:Name="PanelRecentColors" Orientation="Horizontal" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <!-- ======== FIRMWARE ======== -->
            <Grid x:Name="PageFirmware" Visibility="Collapsed">
                <Border Style="{StaticResource Card}" CornerRadius="30" Width="780" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Padding="22,22" MaxHeight="660">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock x:Name="TxtFwTitle" Style="{StaticResource T.Big}" HorizontalAlignment="Center" Margin="0,0,0,10" />
                        <StackPanel Grid.Row="1" Margin="0,0,0,14">
                            <TextBlock Text="{DynamicResource S.FwStep1}" Margin="0,3" TextWrapping="Wrap" />
                            <TextBlock Text="{DynamicResource S.FwStep2}" Margin="0,3" TextWrapping="Wrap" />
                            <TextBlock Text="{DynamicResource S.FwStep3}" Margin="0,3" TextWrapping="Wrap" />
                            <TextBlock Text="{DynamicResource S.FwStep4}" Margin="0,3" TextWrapping="Wrap" Foreground="{DynamicResource B.Logo}" />
                        </StackPanel>
                        <StackPanel Grid.Row="2" HorizontalAlignment="Center" Width="400">
                            <!-- receiver -->
                            <DockPanel Margin="0,4">
                                <TextBlock x:Name="TxtFwRxNew" DockPanel.Dock="Right" Style="{StaticResource T.Title}" />
                                <TextBlock Text="{DynamicResource S.Receiver8K}" Style="{StaticResource T.Title}" />
                            </DockPanel>
                            <TextBlock x:Name="TxtFwRxCur" Style="{StaticResource T.Muted}" HorizontalAlignment="Center" />
                            <Grid Margin="0,6,0,16">
                                <Border x:Name="BarFwRx" Background="{DynamicResource B.Accent}" CornerRadius="15" HorizontalAlignment="Left" Width="0" Opacity="0.55" />
                                <Button x:Name="BtnFwRx" Background="Transparent" Click="FirmwareRx_Click" />
                            </Grid>
                            <!-- mouse -->
                            <DockPanel Margin="0,4">
                                <TextBlock x:Name="TxtFwMouseNew" DockPanel.Dock="Right" Style="{StaticResource T.Title}" />
                                <TextBlock Text="{DynamicResource S.Mouse}" Style="{StaticResource T.Title}" />
                            </DockPanel>
                            <TextBlock x:Name="TxtFwMouseCur" Style="{StaticResource T.Muted}" HorizontalAlignment="Center" />
                            <Grid Margin="0,6,0,10">
                                <Border x:Name="BarFwMouse" Background="{DynamicResource B.Accent}" CornerRadius="15" HorizontalAlignment="Left" Width="0" Opacity="0.55" />
                                <Button x:Name="BtnFwMouse" Background="Transparent" Click="FirmwareMouse_Click" />
                            </Grid>
                            <TextBlock x:Name="TxtFwMessage" Style="{StaticResource T.Muted}" HorizontalAlignment="Center" TextAlignment="Center" />
                        </StackPanel>
                        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
                            <TextBlock x:Name="TxtFwNotes" TextWrapping="Wrap" LineHeight="20" />
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>

            <TextBlock x:Name="TxtStatus" Style="{StaticResource T.Muted}" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                       Margin="0,0,18,6" FontSize="11" />

            <!-- loading overlay: frosted background + the hub's 8-dot spinner -->
            <Grid x:Name="Overlay" Background="{DynamicResource B.Filter}" Visibility="Collapsed">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ContentControl x:Name="SpinnerHost" HorizontalAlignment="Center" />
                    <TextBlock x:Name="TxtOverlay" Style="{StaticResource T.Small}" HorizontalAlignment="Center" Margin="0,14,0,0" />
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
