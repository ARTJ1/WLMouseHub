<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>WLMouseHub</AssemblyName>
    <RootNamespace>WLMouseHub</RootNamespace>
    <Version>1.0.1</Version>
    <Product>WLMouse Hub</Product>
    <Description>Native Windows configurator for WLMOUSE mice</Description>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\models.json" LogicalName="models.json" />
    <Resource Include="Assets\app.ico" />
  </ItemGroup>

</Project>
